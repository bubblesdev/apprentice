# Copy to .env and fill in. Never commit .env.
META_MODEL_API_KEY=
META_MODEL_API_URL=https://api.meta.ai/v1
# auto (live with a key, else fake) | live | replay (recorded responses only) | fake (fixtures/)
APPRENTICE_ADAPTERS=auto
# Every live Meta response is recorded here, keyed by a hash of the request, and replayed after.
META_CACHE_DIR=.cache/meta
# Postgres for guides, sessions, artifacts and pg-boss jobs. Leave empty to run the API in memory.
DATABASE_URL=
PORT=8787
CORS_ORIGIN=http://localhost:5173
# Hard caps on Meta spend.
GUIDE_BUDGET_USD=1.5
SESSION_BUDGET_USD=0.5
# Fake mode only: "pass" makes every live check pass, for walking the UI in development.
APPRENTICE_FAKE_JUDGE=recorded
# Media (evidence frames, diagrams): file (MEDIA_DIR, shared by api and worker) | r2 | memory
MEDIA_STORE=file
MEDIA_DIR=.data/media
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Muse Spark reasoning level for live step checks: minimal | low | medium | high. Empty: model default.
JUDGE_REASONING_EFFORT=

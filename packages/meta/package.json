{
  "name": "@apprentice/meta",
  "version": "0.1.0",
  "description": "Meta Model API adapters for Apprentice: Muse Spark, Muse Wonder, SAM 3.1, Voice Transcribe, Muse Image.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake/index.d.ts",
      "default": "./dist/fake/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "probe": "node dist/probe.js"
  },
  "dependencies": {
    "@apprentice/core": "workspace:*",
    "zod": "^3.23.8"
  },
  "files": [
    "dist"
  ]
}

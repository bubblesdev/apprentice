{
  "name": "@apprentice/eval",
  "version": "0.1.0",
  "description": "Accuracy and cost harness for Apprentice: eval sets from guides and labelled recordings, a cached and capped runner, precision and recall per verdict, coach gate metrics, run comparison, cost per guide and per coaching minute.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "apprentice-eval": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "report": "node dist/cli.js"
  },
  "dependencies": {
    "@apprentice/coach": "workspace:*",
    "@apprentice/core": "workspace:*",
    "@apprentice/meta": "workspace:*",
    "@apprentice/pipeline": "workspace:*",
    "zod": "^3.23.8"
  }
}
